# =============================================================================
# Stage 1 — shared deps (pnpm install runs ONCE)
# =============================================================================
FROM node:22-alpine AS deps
WORKDIR /build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/identity/package.json ./apps/identity/
COPY apps/docs/package.json ./apps/docs/
COPY apps/dashboard/package.json ./apps/dashboard/
COPY packages/amnesia/package.json ./packages/amnesia/
COPY packages/sdk/package.json ./packages/sdk/
RUN corepack enable pnpm && pnpm install --frozen-lockfile \
    --fetch-retries=10 \
    --fetch-retry-mintimeout=20000 \
    --fetch-retry-maxtimeout=120000 \
    --fetch-timeout=300000

# =============================================================================
# Stage 2a — build auth
# =============================================================================
FROM deps AS builder-auth
COPY apps/identity/ ./apps/identity/
RUN cd apps/identity && pnpm build

# =============================================================================
# Stage 2b — build web
# =============================================================================
FROM deps AS builder-web
COPY packages/amnesia/ ./packages/amnesia/
COPY apps/dashboard/ ./apps/dashboard/
ARG VITE_AUTH_URL
ARG VITE_API_URL
ENV VITE_AUTH_URL=${VITE_AUTH_URL}
ENV VITE_API_URL=${VITE_API_URL}
RUN cd packages/amnesia && pnpm build
RUN cd apps/dashboard && pnpm build

# =============================================================================
# Stage 3a — auth runtime
# =============================================================================
FROM node:22-alpine AS auth
RUN apk add --no-cache tini
WORKDIR /app
COPY --from=builder-auth /build/node_modules ./node_modules
COPY --from=builder-auth /build/apps/identity/node_modules ./apps/identity/node_modules
COPY --from=builder-auth /build/apps/identity/dist ./apps/identity/dist
COPY --from=builder-auth /build/apps/identity/package.json ./apps/identity/package.json
COPY --from=builder-auth /build/apps/identity/drizzle ./apps/identity/drizzle
COPY --from=builder-auth /build/apps/identity/drizzle.config.ts ./apps/identity/drizzle.config.ts
# Install drizzle-kit CLI for runtime migrations
RUN npm install -g drizzle-kit
WORKDIR /app/apps/identity
EXPOSE 3000
ENTRYPOINT ["tini", "--"]
CMD ["sh", "-c", "pnpm run db:generate && pnpm run db:migrate && node dist/index.js"]

# =============================================================================
# Stage 3b — web runtime
# =============================================================================
FROM node:22-alpine AS web
RUN apk add --no-cache tini
WORKDIR /app
COPY --from=builder-web /build/apps/dashboard/.output ./
EXPOSE 3000
ENTRYPOINT ["tini", "--"]
CMD ["node", "server/index.mjs"]