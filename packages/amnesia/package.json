{
	"name": "@zenv-sh/amnesia",
	"version": "0.0.1",
	"description": "Pure TypeScript cryptographic engine for zEnv — Argon2id, AES-256-GCM, X25519 NaCl box",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm run build"
	},
	"keywords": [
		"cryptography",
		"aes-256-gcm",
		"argon2id",
		"x25519",
		"nacl",
		"zero-knowledge",
		"encryption"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Judeadeniji/zenv-sh.git",
		"directory": "packages/amnesia"
	},
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"sideEffects": false,
	"dependencies": {
		"hash-wasm": "^4.11.0",
		"tweetnacl": "^1.0.3",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@types/node": "^25.8.0",
		"tsup": "^8.0.0",
		"typescript": "^5"
	}
}
