{
	"name": "@zenv-sh/sdk",
	"version": "0.0.1",
	"description": "Zero-knowledge secret manager SDK — fetch, decrypt, and validate secrets with type safety",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./api": {
			"types": "./src/api.d.ts"
		}
	},
	"files": [
		"dist",
		"src/api.d.ts",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"generate": "openapi-typescript ../../api/docs/openapi.json -o src/api.d.ts",
		"prepublishOnly": "pnpm run build"
	},
	"keywords": [
		"secrets",
		"secret-manager",
		"zero-knowledge",
		"encryption",
		"environment-variables",
		"zenv"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Judeadeniji/zenv-sh.git",
		"directory": "packages/sdk"
	},
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"sideEffects": false,
	"dependencies": {
		"@zenv-sh/amnesia": "workspace:*",
		"openapi-fetch": "^0.17.0"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"openapi-typescript": "^7.13.0",
		"tsup": "^8.0.0",
		"typescript": "^5"
	}
}
