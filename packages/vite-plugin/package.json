{
	"name": "@zenv-sh/vite-plugin",
	"version": "0.0.2",
	"description": "Vite plugin for zEnv — build-time secret injection with zero-knowledge encryption",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm run build"
	},
	"keywords": [
		"vite",
		"vite-plugin",
		"secrets",
		"zero-knowledge",
		"encryption",
		"environment-variables",
		"zenv"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Judeadeniji/zenv-sh.git",
		"directory": "packages/vite-plugin"
	},
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"sideEffects": false,
	"peerDependencies": {
		"vite": ">=8.0.0"
	},
	"dependencies": {
		"@zenv-sh/sdk": "workspace:*"
	},
	"devDependencies": {
		"tsup": "^8.0.0",
		"typescript": "^5",
		"vite": "^8.0.0"
	}
}
