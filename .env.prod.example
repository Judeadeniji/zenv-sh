# Example .env.prod for local production-like testing
# Copy to .env.prod and fill in secrets for your environment

# --- Database ---
POSTGRES_USER=zenv
POSTGRES_PASSWORD=zenv_prod
POSTGRES_DB=zenv
DATABASE_URL=postgres://zenv:zenv_prod@postgres:5432/zenv?sslmode=disable

# --- Redis ---
REDIS_PASSWORD=zenv_redis_prod
REDIS_URL=redis://:zenv_redis_prod@redis:6379/0

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=replace_with_long_random_secret
BETTER_AUTH_URL=https://auth.zenv.localhost/api/auth
TRUSTED_ORIGINS=https://app.zenv.localhost
APP_URL=https://app.zenv.localhost
COOKIE_DOMAIN=.zenv.localhost

# --- OAuth (optional, for local dev you can leave blank) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- API ---
CORS_ORIGINS=https://app.zenv.localhost
LOG_LEVEL=debug

# --- Caddy/Proxy ---
APP_DOMAIN=app.zenv.localhost
AUTH_DOMAIN=auth.zenv.localhost
API_DOMAIN=api.zenv.localhost
ACME_EMAIL=your@email.com

# --- Web (Vite build args) ---
VITE_AUTH_URL=https://auth.zenv.localhost
VITE_API_URL=https://api.zenv.localhost/v1
